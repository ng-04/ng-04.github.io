{
  "rules": {
    ".read": false,
    ".write": false,
    "live": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'ADMIN_UID_HERE'",
      ".validate": "newData.hasChildren(['idx'])",
      "idx": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 659" },
      "at": { ".validate": "newData.isNumber()" },
      "$other": { ".validate": false }
    }
  }
}
